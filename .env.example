# Generate a long random value; never commit a real key.
ASL_API_KEYS=replace-with-at-least-16-random-characters
ASL_POLICY_PATH=policies/warehouse.yml
ASL_DATABASE_URL=sqlite:///agent_safety_lab.db
ASL_ENVIRONMENT=development
ASL_RATE_LIMIT_REQUESTS=120
ASL_RATE_LIMIT_WINDOW_SECONDS=60
ASL_SIGNING_SECRET=replace-with-at-least-32-random-characters
ASL_TOKEN_TTL_SECONDS=30

# Required by docker-compose.yml; generate a strong unique password.
POSTGRES_PASSWORD=replace-with-a-strong-random-database-password

# Optional comma-separated exact origins. Empty means CORS middleware is off.
ASL_CORS_ORIGINS=http://localhost:3000
