# Generate a long random value; never commit a real key.
EXECUSEAL_API_KEYS=replace-with-at-least-16-random-characters
EXECUSEAL_REVIEWER_API_KEYS=use-a-different-reviewer-secret
EXECUSEAL_POLICY_PATH=policies/warehouse.yml
EXECUSEAL_DATABASE_URL=sqlite:///execuseal.db
EXECUSEAL_ENVIRONMENT=development
EXECUSEAL_RATE_LIMIT_REQUESTS=120
EXECUSEAL_RATE_LIMIT_WINDOW_SECONDS=60
EXECUSEAL_SIGNING_KEYS_JSON={"key-2026-09":"replace-with-base64-32-byte-private-key"}
EXECUSEAL_ACTIVE_SIGNING_KEY_ID=key-2026-09
EXECUSEAL_TOKEN_TTL_SECONDS=30
EXECUSEAL_APPROVAL_TTL_SECONDS=900

# Required by docker-compose.yml; generate a strong unique password.
POSTGRES_PASSWORD=replace-with-a-strong-random-database-password

# Optional comma-separated exact origins. Empty means CORS middleware is off.
EXECUSEAL_CORS_ORIGINS=http://localhost:3000
